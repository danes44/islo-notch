// Islo settings app — follows the Windows light/dark theme (the island is always dark).
// Built from the Islo design system: monochrome controls, feature color only on
// feature glyphs, "Saved" confirmation per row, calm motion (no bounce).

import { Icon, LineIcon, Icons, BrandMark, Mochi } from "icons.slint";

export global S {
    in property <bool> dark: true;
    in property <bool> reduce: false;
    out property <color> surface-100: dark ? #000000 : #f3f3f3;
    out property <color> surface-200: dark ? #111111 : #ffffff;
    out property <color> surface-300: dark ? #2a2a2a : #ebebeb;
    out property <color> hairline: dark ? #1a1a1a : #e5e5e5;
    out property <color> border: dark ? #7a7a7a : #858585;
    out property <color> ink: dark ? #ffffff : #0a0a0a;
    out property <color> ink-muted: dark ? #b4b4b4 : #5e5e5e;
    out property <color> ink-faint: dark ? #949494 : #696969;
    out property <color> primary: dark ? #ffffff : #0a0a0a;
    out property <color> on-primary: dark ? #000000 : #ffffff;
    out property <color> positive: dark ? #46a758 : #2e7d32;
    out property <color> rose: dark ? #fc90bc : #b54879;
    out property <color> orange: dark ? #f99f55 : #ab5e0c;
    out property <color> green: dark ? #6fd087 : #0e8c41;
    out property <color> blue: dark ? #71bfff : #037ac0;
    out property <color> indigo: dark ? #a9b0fd : #6566c9;
    out property <duration> instant: reduce ? 0ms : 90ms;
    out property <duration> quick: reduce ? 0ms : 180ms;
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    width: 40px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: !enabled ? S.hairline : checked ? S.primary : S.border;
    background: !enabled ? S.surface-300 : checked ? S.primary : S.surface-200;
    animate background, border-color { duration: S.quick; }
    knob := Rectangle {
        width: ta.pressed && root.enabled ? 16px : 12px;
        height: 12px;
        y: 3px;
        x: root.checked ? root.width - self.width - 4px : 3px;
        border-radius: 6px;
        background: !root.enabled ? S.border : root.checked ? S.on-primary : S.ink-muted;
        animate x, width, background { duration: S.quick; easing: ease-out; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value: 50;
    in property <bool> enabled: true;
    callback changed(float);
    callback released();
    width: 200px;
    height: 20px;
    property <float> pct: (value - minimum) / (maximum - minimum);
    Rectangle {
        y: 8px;
        height: 4px;
        border-radius: 2px;
        background: S.surface-300;
    }
    Rectangle {
        x: 0;
        y: 8px;
        height: 4px;
        width: (root.width - 20px) * root.pct + 10px;
        border-radius: 2px;
        background: root.enabled ? S.primary : S.border;
    }
    Rectangle {
        x: (root.width - 20px) * root.pct;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: S.surface-200;
        border-width: 1px;
        border-color: S.border;
        Rectangle {
            width: ta.pressed ? 10px : 12px;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: root.enabled ? S.primary : S.border;
            animate width { duration: S.instant; }
        }
    }
    function set-from(px: length) {
        if (!root.enabled) { return; }
        let raw = root.minimum + clamp((px - 10px) / (root.width - 20px), 0, 1) * (root.maximum - root.minimum);
        let v = round(raw / root.step) * root.step;
        if (v != root.value) {
            root.value = v;
            root.changed(v);
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { set-from(self.mouse-x); }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => { set-from(self.mouse-x); }
    }
}

component Segmented inherits HorizontalLayout {
    in property <[string]> options;
    in-out property <int> current;
    callback selected(int);
    spacing: 4px;
    for opt[i] in root.options : Rectangle {
        height: 32px;
        width: lbl.preferred-width + 24px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.current == i ? S.primary : S.border;
        background: root.current == i ? S.primary : seg-ta.has-hover ? S.surface-300 : S.surface-200;
        animate background { duration: S.instant; }
        lbl := Text {
            text: opt;
            font-size: 13px;
            font-weight: 600;
            color: root.current == i ? S.on-primary : S.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
        seg-ta := TouchArea {
            clicked => {
                root.current = i;
                root.selected(i);
            }
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    width: lbl.preferred-width + 24px;
    border-radius: 4px;
    border-width: primary && enabled ? 0px : 1px;
    border-color: enabled ? S.border : S.hairline;
    background: !enabled ? S.surface-300 : primary ? (ta.pressed ? S.ink-muted : S.primary) : ta.has-hover ? S.surface-300 : S.surface-200;
    animate background { duration: S.instant; }
    lbl := Text {
        text: root.text;
        font-size: 14px;
        font-weight: 600;
        color: !root.enabled ? S.ink-faint : root.primary ? S.on-primary : S.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component TextField inherits Rectangle {
    in-out property <string> text;
    callback edited();
    width: 200px;
    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: ti.has-focus ? S.primary : S.border;
    background: S.surface-200;
    ti := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.text;
        color: S.ink;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(); }
    }
}

struct Skin {
    name: string,
    head: color,
    eyes: color,
}

/// Mochi's looks, as small tiles. Order must match pet::SKINS.
component SkinPicker inherits HorizontalLayout {
    in-out property <int> current;
    callback selected(int);
    property <[Skin]> skins: [
        { name: "Classic", head: #000000, eyes: #d3b63b },
        { name: "Snow", head: #f5f5f5, eyes: #000000 },
        { name: "Rose", head: #fc90bc, eyes: #000000 },
        { name: "Mint", head: #6fd087, eyes: #000000 },
        { name: "Sky", head: #71bfff, eyes: #000000 },
        { name: "Ember", head: #f99f55, eyes: #000000 },
    ];
    spacing: 6px;
    for skin[i] in root.skins : Rectangle {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border-width: root.current == i ? 2px : 1px;
        border-color: root.current == i ? S.primary : S.border;
        // mid grey so both the black and the white heads read
        background: skin-ta.has-hover ? #8a8a8a : #7a7a7a;
        animate background { duration: S.instant; }
        Mochi {
            x: 6px;
            y: 6px;
            width: 24px;
            height: 24px;
            head: skin.head;
            eyes: skin.eyes;
        }
        skin-ta := TouchArea {
            clicked => {
                root.current = i;
                root.selected(i);
            }
        }
    }
}

/// Color dots plus "Custom…", which opens Windows' color picker (any color).
/// A picked color that isn't one of the dots shows as an extra, selected dot.
component ColorPicker inherits HorizontalLayout {
    in property <[color]> colors;
    in property <color> current;
    in property <bool> custom-active; // `current` isn't one of `colors`
    callback picked(color);
    callback custom();
    spacing: 8px;
    alignment: end;
    for c in root.colors : Rectangle {
        width: 32px;
        height: 32px;
        Rectangle {
            visible: root.current == c && !root.custom-active;
            border-radius: 16px;
            border-width: 2px;
            border-color: S.primary;
        }
        Rectangle {
            x: 5px;
            y: 5px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: c;
            border-width: 1px;
            border-color: dot-ta.has-hover ? S.ink : S.border;
        }
        dot-ta := TouchArea {
            clicked => { root.picked(c); }
        }
    }
    if root.custom-active : Rectangle {
        width: 32px;
        height: 32px;
        border-radius: 16px;
        border-width: 2px;
        border-color: S.primary;
        Rectangle {
            x: 5px;
            y: 5px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: root.current;
            border-width: 1px;
            border-color: S.border;
        }
    }
    Button {
        text: "Custom…";
        clicked => { root.custom(); }
    }
}

component Badge inherits Rectangle {
    in property <string> text: "New";
    height: 20px;
    width: lbl.preferred-width + 16px;
    border-radius: 10px;
    background: S.surface-300;
    lbl := Text {
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        color: S.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

// A settings row: name + description on the left, a control on the right,
// and a short "Saved" confirmation after a change.
component Row inherits Rectangle {
    in property <string> name;
    in property <string> desc;
    in property <bool> first: false;
    in property <bool> saved: false;
    in property <bool> new-badge: false;
    in property <color> glyph-color: transparent;
    in property <string> glyph: "";
    // Wrapped descriptions don't grow the row by themselves, so long ones ask for more room.
    in property <length> min-h: 56px;
    min-height: root.min-h;
    background: ta.has-hover ? S.surface-300 : transparent;
    animate background { duration: S.instant; }
    ta := TouchArea { }
    if !root.first : Rectangle {
        y: 0;
        height: 1px;
        background: S.hairline;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        if root.glyph != "" : Icon {
            d: root.glyph;
            fill: root.glyph-color;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.name;
                    font-size: 14px;
                    font-weight: 600;
                    color: S.ink;
                    vertical-alignment: center;
                }
                if root.new-badge : Badge { }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.desc != "" : Text {
                text: root.desc;
                font-size: 12px;
                color: S.ink-muted;
                wrap: word-wrap;
            }
        }
        Text {
            text: "Saved";
            font-size: 12px;
            color: S.positive;
            vertical-alignment: center;
            opacity: root.saved ? 1 : 0;
            animate opacity { duration: S.quick; }
        }
        @children
    }
}

component Card inherits Rectangle {
    background: S.surface-200;
    border-width: 1px;
    border-color: S.hairline;
    border-radius: 8px;
    clip: true;
    VerticalLayout {
        @children
    }
}

component SectionTitle inherits Text {
    font-size: 16px;
    font-weight: 600;
    color: S.ink;
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 36px;
    border-radius: 4px;
    background: active ? S.surface-300 : ta.has-hover ? S.surface-300.with-alpha(0.5) : transparent;
    animate background { duration: S.instant; }
    // Windows 11 style selection pill
    Rectangle {
        visible: root.active;
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: S.primary;
    }
    Text {
        x: 14px;
        text: root.text;
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        color: S.ink;
        vertical-alignment: center;
        height: parent.height;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SettingsWindow inherits Window {
    title: "Islo Settings";
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 760px;
    min-height: 480px;
    default-font-family: "Segoe UI Variable Text";
    background: S.surface-100;

    in property <bool> dark: true;
    in property <bool> reduce-ui: false;
    changed dark => { S.dark = root.dark; }
    changed reduce-ui => { S.reduce = root.reduce-ui; }
    init => {
        S.dark = root.dark;
        S.reduce = root.reduce-ui;
    }

    in-out property <int> page: 1; // 0 General, 1 Appearance, 2 Modules, 3 Shortcuts, 4 About
    in property <string> saved-key: "";
    // Changes wait in the window until Save (Islo writes islo.ini and reads it back).
    in property <bool> dirty: false;
    in property <int> save-state: 0;      // 0 nothing yet, 1 saved, 2 error
    in property <string> save-msg: "";    // the error, or where it was saved
    in property <bool> close-warn: false; // tried to close with unsaved changes

    // ---- appearance ----
    in-out property <float> width-px: 200;
    in-out property <int> edge: 0;
    in-out property <bool> taskbar: false;
    in-out property <int> side-style: 0;
    in-out property <bool> hover-expand: true;
    in-out property <float> hover-delay: 300;
    in-out property <int> theme: 0;
    in-out property <bool> reduce-motion: false;
    in property <bool> system-reduce-motion: false;
    in-out property <int> show-on: 0;
    in-out property <bool> pill-glance: true;
    in-out property <bool> header-date: true;
    in-out property <int> featured: 3; // 0 none, 1 media, 2 timer, 3 pet, 4 focus
    in-out property <int> clock: 1;    // 0 clock, 1 clock and date, 2 date
    in-out property <bool> keep-open: false;
    in-out property <bool> soft-shadow: true;
    in-out property <bool> media-rest: true;
    in-out property <int> lyric-align: 0;
    in-out property <bool> pet-touch: true;
    in-out property <bool> games: true;
    in-out property <bool> games-online: true;
    in property <bool> online-built: false; // this build knows the relay
    // ---- modules ----
    in-out property <bool> mod-media: true;
    in-out property <bool> art-tint: true;
    in-out property <bool> mod-lyrics: true;
    in-out property <float> lyric-lines: 3;
    in-out property <bool> mod-hud: true;
    in-out property <bool> mod-battery: true;
    in-out property <bool> mod-shelf: true;
    in-out property <bool> mod-notifications: false;
    // 0 the toggle, 1 "Set up" (Islo isn't registered with Windows yet), 2 setting up
    in property <int> notifications-setup: 1;
    in property <string> notifications-desc: "";
    in-out property <bool> mod-timer: true;
    in-out property <bool> mod-privacy: true;
    in-out property <bool> mod-focus: true;
    in-out property <bool> mod-pet: true;
    in-out property <bool> pet-nearby: true;
    in-out property <bool> pet-share-name: false;
    in property <string> owner-name: "";    // first name of the Windows user
    in-out property <bool> pet-peek: true;
    in-out property <bool> pet-track: true;
    in-out property <string> pet-name: "Mochi";
    in-out property <int> pet-skin: 0;  // preset, -1 custom colors
    in property <color> pet-body: #000000;
    in property <color> pet-eyes: #d3b63b;
    in property <bool> pet-body-custom: false; // not one of the dots
    in property <bool> pet-eyes-custom: false;
    in property <string> pet-eyes-desc: "";
    in-out property <int> pet-size: 1;  // 0 small, 1 medium, 2 large
    in-out property <int> pet-moves: 2; // 0 peek, 1 walk around, 2 both
    in-out property <int> pet-often: 1; // 0 rarely, 1 sometimes, 2 often
    in-out property <bool> hide-fullscreen: true;
    in-out property <bool> saver-pause: true;
    // ---- general ----
    in-out property <bool> autostart: false;
    in property <string> memory-text: "";
    in property <string> version: "0.2.0";
    // ---- updates ----
    in-out property <bool> update-check: true;
    in property <int> update-state: 0; // 0 idle, 1 checking, 2 available, 3 installing, 4 up to date, 5 error
    in property <string> update-version: ""; // the new version, when available
    in property <string> update-desc: "Islo looks for a new version once a day.";
    // phases still being built hide their rows
    in property <bool> has-lyrics: false;
    in property <bool> has-pet: false;
    in property <bool> has-live: false; // timer / mic / focus indicators

    callback changed(string);
    callback save-changes();
    callback discard-changes();
    callback reset-position();
    callback restore-defaults();
    callback quit-app();
    callback check-update();
    callback install-update();
    callback open-releases();
    callback set-up-notifications();
    callback remove-notifications();
    callback set-pet-color(int, color); // 0 body, 1 eyes
    callback pick-pet-color(int);       // Windows' color picker for body (0) or eyes (1)

    HorizontalLayout {
        // ---------- sidebar ----------
        VerticalLayout {
            width: 240px;
            padding: 16px;
            padding-top: 20px;
            spacing: 4px;
            HorizontalLayout {
                padding-left: 6px;
                padding-bottom: 16px;
                spacing: 10px;
                BrandMark {
                    width: 36px;
                    height: 36px;
                    on-dark: S.dark;
                }
                VerticalLayout {
                    Text {
                        text: "Islo";
                        font-size: 15px;
                        font-weight: 600;
                        color: S.ink;
                    }
                    Text {
                        text: "Settings";
                        font-size: 12px;
                        color: S.ink-muted;
                    }
                }
            }
            NavItem { text: "General"; active: root.page == 0; clicked => { root.page = 0; } }
            NavItem { text: "Appearance"; active: root.page == 1; clicked => { root.page = 1; } }
            NavItem { text: "Modules"; active: root.page == 2; clicked => { root.page = 2; } }
            NavItem { text: "Shortcuts"; active: root.page == 3; clicked => { root.page = 3; } }
            NavItem { text: "About"; active: root.page == 4; clicked => { root.page = 4; } }
            Rectangle { vertical-stretch: 1; }
        }

        // ---------- page + save bar ----------
        VerticalLayout {
        horizontal-stretch: 1;
        Flickable {
            vertical-stretch: 1;
            content-height: pagebody.preferred-height;
            pagebody := VerticalLayout {
                width: parent.width;
                padding: 32px;
                padding-top: 28px;
                spacing: 24px;
                alignment: start;

                Text {
                    text: root.page == 0 ? "General" : root.page == 1 ? "Appearance" : root.page == 2 ? "Modules" : root.page == 3 ? "Shortcuts" : "About";
                    font-size: 28px;
                    font-weight: 600;
                    color: S.ink;
                }

                // ======== General ========
                if root.page == 0 : VerticalLayout {
                    spacing: 12px;
                    Card {
                        Row {
                            first: true;
                            name: "Start with Windows";
                            desc: "Islo opens quietly when you sign in.";
                            saved: root.saved-key == "autostart";
                            Toggle { y: 18px; checked <=> root.autostart; toggled => { root.changed("autostart"); } }
                        }
                        Row {
                            name: "Open settings";
                            desc: "Right-click the island, or use the Islo icon in the system tray.";
                        }
                        Row {
                            name: "Quit Islo";
                            desc: "The island goes away until you start Islo again.";
                            Button { y: 12px; text: "Quit"; clicked => { root.quit-app(); } }
                        }
                    }
                }

                // ======== Appearance ========
                if root.page == 1 : VerticalLayout {
                    spacing: 12px;
                    SectionTitle { text: "Island"; }
                    Card {
                        Row {
                            first: true;
                            name: "Island width";
                            desc: "How wide the small island is. Press Save to resize it.";
                            saved: root.saved-key == "width";
                            HorizontalLayout {
                                spacing: 12px;
                                Slider {
                                    y: 18px;
                                    minimum: 160;
                                    maximum: 300;
                                    step: 10;
                                    value <=> root.width-px;
                                    changed => { root.changed("width"); }
                                }
                                Text {
                                    width: 52px;
                                    text: round(root.width-px) + " px";
                                    font-size: 13px;
                                    color: S.ink-muted;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                        Row {
                            name: "Edge";
                            min-h: 78px;
                            desc: "Drag the island to any edge of the screen, or pick one here. On the left and right it turns vertical.";
                            saved: root.saved-key == "edge";
                            HorizontalLayout {
                                spacing: 8px;
                                Segmented {
                                    y: 12px;
                                    options: ["Top", "Bottom", "Left", "Right"];
                                    current <=> root.edge;
                                    selected => { root.changed("edge"); }
                                }
                                Button { y: 12px; text: "Reset position"; clicked => { root.reset-position(); } }
                            }
                        }
                        Row {
                            name: "Inside the taskbar";
                            min-h: 78px;
                            new-badge: true;
                            desc: "The island sits in the middle of the taskbar and your taskbar apps move to the left. Turn it off, drag the island to another edge or quit Islo, and they go back.";
                            saved: root.saved-key == "taskbar";
                            Toggle { y: 18px; checked <=> root.taskbar; toggled => { root.changed("taskbar"); } }
                        }
                        Row {
                            name: "On the left or right edge";
                            min-h: 78px;
                            desc: "The island shrinks to show only what's live. Hover a glyph to open that feature.";
                            saved: root.saved-key == "side";
                            Segmented {
                                y: 12px;
                                options: ["Icon tab", "Thin sliver", "Full vertical pill"];
                                current <=> root.side-style;
                                selected => { root.changed("side"); }
                            }
                        }
                        Row {
                            name: "Expand on hover";
                            desc: "The island opens when your pointer rests on it. Off: click to open.";
                            saved: root.saved-key == "hover";
                            Toggle { y: 18px; checked <=> root.hover-expand; toggled => { root.changed("hover"); } }
                        }
                        Row {
                            name: "Hover delay";
                            desc: root.hover-expand ? "How long your pointer rests before the island opens." : "Turn on Expand on hover to change this.";
                            saved: root.saved-key == "delay";
                            HorizontalLayout {
                                spacing: 12px;
                                Slider {
                                    y: 18px;
                                    minimum: 100;
                                    maximum: 1000;
                                    step: 50;
                                    enabled: root.hover-expand;
                                    value <=> root.hover-delay;
                                    changed => { root.changed("delay"); }
                                }
                                Text {
                                    width: 52px;
                                    text: round(root.hover-delay) + " ms";
                                    font-size: 13px;
                                    color: S.ink-muted;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                        Row {
                            name: "Keep the island open";
                            new-badge: true;
                            min-h: 78px;
                            desc: "Pinned: the island stays open on any edge, as if you never moved away. Same as the pin in the island. Esc or Win + Alt + I unpins it.";
                            saved: root.saved-key == "pin";
                            Toggle { y: 18px; checked <=> root.keep-open; toggled => { root.changed("pin"); } }
                        }
                        Row {
                            name: "Soft shadow";
                            new-badge: true;
                            desc: "A soft shadow under the island so it floats a little off the desktop.";
                            saved: root.saved-key == "shadow";
                            Toggle { y: 18px; checked <=> root.soft-shadow; toggled => { root.changed("shadow"); } }
                        }
                    }
                    SectionTitle { text: "At a glance"; }
                    Card {
                        Row {
                            first: true;
                            name: "Clock and battery in the pill";
                            min-h: 64px;
                            desc: "When nothing is live, the small island shows a feature on the left and the clock or date and the battery on the right.";
                            saved: root.saved-key == "glance";
                            Toggle { y: 18px; checked <=> root.pill-glance; toggled => { root.changed("glance"); } }
                        }
                        Row {
                            name: "Featured on the left";
                            min-h: 78px;
                            desc: root.pill-glance ? "What sits on the left of the pill while it's quiet. Live activities still take over." : "Turn on Clock and battery in the pill to change this.";
                            saved: root.saved-key == "featured";
                            Segmented {
                                y: 12px;
                                options: ["None", "Media", "Timer", "Pet", "Focus"];
                                current <=> root.featured;
                                selected => { root.changed("featured"); }
                            }
                        }
                        Row {
                            name: "Show on the right";
                            new-badge: true;
                            min-h: 78px;
                            desc: "For the quiet pill and the top of the open island (shortened there when many tabs need the room). The time follows your Windows format.";
                            saved: root.saved-key == "clock";
                            Segmented {
                                y: 12px;
                                options: ["Clock", "Clock and date", "Date"];
                                current <=> root.clock;
                                selected => { root.changed("clock"); }
                            }
                        }
                        Row {
                            name: "Clock in the open island";
                            desc: "Shows it next to the battery at the top of the expanded island.";
                            saved: root.saved-key == "hdate";
                            Toggle { y: 18px; checked <=> root.header-date; toggled => { root.changed("hdate"); } }
                        }
                    }
                    SectionTitle { text: "Look and motion"; }
                    Card {
                        Row {
                            first: true;
                            name: "App theme";
                            min-h: 78px;
                            desc: "Changes this window. The island stays black in every theme.";
                            saved: root.saved-key == "theme";
                            Segmented {
                                y: 12px;
                                options: ["Use Windows setting", "Light", "Dark"];
                                current <=> root.theme;
                                selected => { root.changed("theme"); }
                            }
                        }
                        Row {
                            name: "Reduce animations";
                            min-h: 78px;
                            desc: root.system-reduce-motion ? "Windows “Animation effects” is off, so Islo already uses quick fades." : "Swaps the bounce for a quick fade and stops the waveform. Follows Windows “Animation effects” until you change it.";
                            saved: root.saved-key == "reduce";
                            Toggle { y: 18px; checked <=> root.reduce-motion; toggled => { root.changed("reduce"); } }
                        }
                        Row {
                            name: "Show on";
                            min-h: 78px;
                            desc: "Where the island appears when more than one display is connected.";
                            saved: root.saved-key == "showon";
                            Segmented {
                                y: 12px;
                                options: ["Main display", "All displays", "Display with the pointer"];
                                current <=> root.show-on;
                                selected => { root.changed("showon"); }
                            }
                        }
                    }
                }

                // ======== Modules ========
                if root.page == 2 : VerticalLayout {
                    spacing: 12px;
                    Card {
                        Row {
                            first: true;
                            glyph: Icons.note;
                            glyph-color: S.rose;
                            name: "Media controls";
                            desc: "Show what's playing from Spotify, browsers and other apps.";
                            saved: root.saved-key == "media";
                            Toggle { y: 18px; checked <=> root.mod-media; toggled => { root.changed("media"); } }
                        }
                        Row {
                            name: "Colors from album art";
                            new-badge: true;
                            desc: "The waveform, the art's border and the controls take the album's color. Off: plain white.";
                            saved: root.saved-key == "arttint";
                            Toggle { y: 18px; checked <=> root.art-tint; toggled => { root.changed("arttint"); } }
                        }
                        Row {
                            name: "Rest after music pauses";
                            new-badge: true;
                            desc: root.mod-media ? "5 seconds after you pause, the pill goes back to the quiet view. Press play to bring it back." : "Turn on Media controls to change this.";
                            saved: root.saved-key == "rest";
                            Toggle { y: 18px; enabled: root.mod-media; checked <=> root.media-rest; toggled => { root.changed("rest"); } }
                        }
                        if root.has-lyrics : Row {
                            glyph: Icons.note;
                            glyph-color: S.rose;
                            name: "Lyrics";
                            new-badge: true;
                            min-h: 64px;
                            desc: "Synced lyrics from any player (Spotify, browsers, YouTube, desktop apps). A small lyrics mark shows whether the song has them.";
                            saved: root.saved-key == "lyrics";
                            Toggle { y: 18px; checked <=> root.mod-lyrics; toggled => { root.changed("lyrics"); } }
                        }
                        if root.has-lyrics : Row {
                            name: "Lyric lines";
                            desc: root.mod-lyrics ? "Lines shown while you are not hovering. Hover the island to see the whole song." : "Turn on Lyrics to change this.";
                            saved: root.saved-key == "lines";
                            HorizontalLayout {
                                spacing: 12px;
                                Slider {
                                    y: 18px;
                                    minimum: 1;
                                    maximum: 10;
                                    step: 1;
                                    enabled: root.mod-lyrics;
                                    value <=> root.lyric-lines;
                                    changed => { root.changed("lines"); }
                                }
                                Text {
                                    width: 52px;
                                    text: root.lyric-lines == 1 ? "1 line" : round(root.lyric-lines) + " lines";
                                    font-size: 13px;
                                    color: S.ink-muted;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                        }
                        if root.has-lyrics : Row {
                            name: "Lyrics alignment";
                            new-badge: true;
                            min-h: 78px;
                            desc: root.mod-lyrics ? "Lines under the closed island and the whole song in the open one." : "Turn on Lyrics to change this.";
                            saved: root.saved-key == "align";
                            Segmented {
                                y: 12px;
                                options: ["Left", "Center", "Right"];
                                current <=> root.lyric-align;
                                selected => { root.changed("align"); }
                            }
                        }
                        Row {
                            glyph: Icons.speaker;
                            glyph-color: S.ink;
                            name: "Volume and brightness";
                            desc: "Replace the Windows flyout with a quiet pill in the island.";
                            saved: root.saved-key == "hud";
                            Toggle { y: 18px; checked <=> root.mod-hud; toggled => { root.changed("hud"); } }
                        }
                        Row {
                            glyph: Icons.bolt;
                            glyph-color: S.green;
                            name: "Battery and charging";
                            desc: "Show the charge when you plug in, and warn when the battery runs low.";
                            saved: root.saved-key == "battery";
                            Toggle { y: 18px; checked <=> root.mod-battery; toggled => { root.changed("battery"); } }
                        }
                        Row {
                            name: "File shelf";
                            new-badge: true;
                            desc: "A tab where files wait for you: drag them onto the island, add or paste them, then drag them out anywhere.";
                            saved: root.saved-key == "shelf";
                            Toggle { y: 18px; checked <=> root.mod-shelf; toggled => { root.changed("shelf"); } }
                        }
                        if root.has-live : Row {
                            name: "Timers";
                            desc: "Start a timer from the opened island; it counts down in the pill.";
                            saved: root.saved-key == "timer";
                            Toggle { y: 18px; checked <=> root.mod-timer; toggled => { root.changed("timer"); } }
                        }
                        if root.has-live : Row {
                            name: "Mic and camera";
                            desc: "A steady dot while an app uses them.";
                            saved: root.saved-key == "privacy";
                            Toggle { y: 18px; checked <=> root.mod-privacy; toggled => { root.changed("privacy"); } }
                        }
                        if root.has-live : Row {
                            glyph: Icons.moon;
                            glyph-color: S.indigo;
                            name: "Focus";
                            desc: "Show when Windows Focus is on.";
                            saved: root.saved-key == "focus";
                            Toggle { y: 18px; checked <=> root.mod-focus; toggled => { root.changed("focus"); } }
                        }
                        Row {
                            name: "Notifications";
                            desc: root.notifications-desc;
                            saved: root.saved-key == "notifications";
                            min-h: 72px;
                            // Remove unregisters Islo (and restarts it); centered with the toggle
                            if root.notifications-setup == 0 : HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Remove";
                                        clicked => { root.remove-notifications(); }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Toggle {
                                        checked <=> root.mod-notifications;
                                        toggled => { root.changed("notifications"); }
                                    }
                                }
                            }
                            if root.notifications-setup == 1 : Button {
                                y: 20px;
                                text: "Set up";
                                clicked => { root.set-up-notifications(); }
                            }
                        }
                    }

                    if root.has-pet : SectionTitle { text: "Pet"; }
                    if root.has-pet : Card {
                        Row {
                            first: true;
                            name: "Pet";
                            new-badge: true;
                            min-h: 64px;
                            desc: "Mochi, the Islo mascot, lives in the island. It naps when you stop moving the pointer and never moves in full-screen apps.";
                            saved: root.saved-key == "pet";
                            Toggle { y: 18px; checked <=> root.mod-pet; toggled => { root.changed("pet"); } }
                        }
                        Row {
                            name: "Name";
                            desc: "Friends see this name when your pet visits.";
                            saved: root.saved-key == "petname";
                            TextField { y: 12px; text <=> root.pet-name; edited => { root.changed("petname"); } }
                        }
                        Row {
                            name: "Look";
                            min-h: 64px;
                            desc: "Start from a preset, then change either color below.";
                            saved: root.saved-key == "skin";
                            SkinPicker {
                                y: 10px;
                                current <=> root.pet-skin;
                                selected => { root.changed("skin"); }
                            }
                        }
                        Row {
                            name: "Body color";
                            min-h: 64px;
                            desc: "Mochi's head, ears and all.";
                            saved: root.saved-key == "petbody";
                            ColorPicker {
                                y: 12px;
                                colors: [#000000, #3a3a3a, #f5f5f5, #fc90bc, #f99f55, #d3b63b, #6fd087, #71bfff];
                                current: root.pet-body;
                                custom-active: root.pet-body-custom;
                                picked(c) => { root.set-pet-color(0, c); }
                                custom => { root.pick-pet-color(0); }
                            }
                        }
                        Row {
                            name: "Eye color";
                            min-h: 64px;
                            desc: root.pet-eyes-desc;
                            saved: root.saved-key == "peteyes";
                            ColorPicker {
                                y: 12px;
                                colors: [#d3b63b, #000000, #ffffff, #fc90bc, #f99f55, #6fd087, #71bfff];
                                current: root.pet-eyes;
                                custom-active: root.pet-eyes-custom;
                                picked(c) => { root.set-pet-color(1, c); }
                                custom => { root.pick-pet-color(1); }
                            }
                        }
                        Row {
                            name: "Size";
                            desc: "How big Mochi is when it comes out of the island.";
                            saved: root.saved-key == "petsize";
                            Segmented {
                                y: 12px;
                                options: ["Small", "Medium", "Large"];
                                current <=> root.pet-size;
                                selected => { root.changed("petsize"); }
                            }
                        }
                        Row {
                            name: "Come out of the island";
                            min-h: 78px;
                            desc: root.reduce-motion || root.system-reduce-motion ? "Off while Reduce animations is on." : "Now and then, unless something urgent is showing, Mochi peeks out or walks around the island. It keeps going while you hover, and gets dragged along when the island opens. Click Mochi and it hides.";
                            saved: root.saved-key == "peek";
                            Toggle { y: 18px; checked <=> root.pet-peek; toggled => { root.changed("peek"); } }
                        }
                        Row {
                            name: "What Mochi does";
                            desc: root.pet-peek ? "Peek from under or beside the island, walk all the way around it, or a mix." : "Turn on Come out of the island to change this.";
                            saved: root.saved-key == "moves";
                            Segmented {
                                y: 12px;
                                options: ["Peek", "Walk around", "Both"];
                                current <=> root.pet-moves;
                                selected => { root.changed("moves"); }
                            }
                        }
                        Row {
                            name: "How often";
                            desc: "Rarely: every minute or so. Sometimes: every 15 to 35 seconds. Often: every few seconds.";
                            min-h: 64px;
                            saved: root.saved-key == "often";
                            Segmented {
                                y: 12px;
                                options: ["Rarely", "Sometimes", "Often"];
                                current <=> root.pet-often;
                                selected => { root.changed("often"); }
                            }
                        }
                        Row {
                            name: "Eyes follow the pointer";
                            min-h: 64px;
                            desc: "Mochi watches your pointer while it's on screen. Turn this off and Mochi only wakes when you hover the island.";
                            saved: root.saved-key == "track";
                            Toggle { y: 18px; checked <=> root.pet-track; toggled => { root.changed("track"); } }
                        }
                        Row {
                            name: "Pet and carry Mochi";
                            new-badge: true;
                            min-h: 64px;
                            desc: "Stroke Mochi back and forth to pet it. Press and drag it to carry it around the island.";
                            saved: root.saved-key == "touch";
                            Toggle { y: 18px; checked <=> root.pet-touch; toggled => { root.changed("touch"); } }
                        }
                        Row {
                            name: "Visit friends nearby";
                            min-h: 64px;
                            desc: "Uses Bluetooth to find Islo on PCs in the same room. Any device in range can read your pet's name. Nothing goes over the internet.";
                            saved: root.saved-key == "nearby";
                            Toggle { y: 18px; checked <=> root.pet-nearby; toggled => { root.changed("nearby"); } }
                        }
                        Row {
                            name: "Show my name";
                            min-h: 64px;
                            desc: root.pet-share-name
                                ? "Friends see “" + root.owner-name + "'s laptop”. Any device in Bluetooth range can read this name."
                                : "Friends see “A friend's laptop”. Turn on to show your first name, " + root.owner-name + ", instead.";
                            saved: root.saved-key == "sharename";
                            Toggle {
                                y: 18px;
                                enabled: root.pet-nearby;
                                checked <=> root.pet-share-name;
                                toggled => { root.changed("sharename"); }
                            }
                        }
                    }

                    SectionTitle { text: "Games"; }
                    Card {
                        Row {
                            first: true;
                            name: "Tic-tac-toe";
                            new-badge: true;
                            desc: "A tab with tic-tac-toe: play Mochi at Easy, Medium or Hard.";
                            saved: root.saved-key == "games";
                            Toggle { y: 18px; checked <=> root.games; toggled => { root.changed("games"); } }
                        }
                        Row {
                            name: "Online games";
                            min-h: 64px;
                            desc: !root.online-built ? "This build of Islo has no game server set up."
                                : "Play a friend anywhere with a 4-letter room code. Moves go through Islo's free relay, nothing else is stored. On busy days the free server can run out until tomorrow.";
                            saved: root.saved-key == "online";
                            Toggle { y: 18px; enabled: root.games && root.online-built; checked <=> root.games-online; toggled => { root.changed("online"); } }
                        }
                    }

                    SectionTitle { text: "Full-screen apps"; }
                    Card {
                        Row {
                            first: true;
                            name: "Hide in full-screen apps";
                            desc: "The island steps aside for games, videos and presentations, and comes back when you leave.";
                            saved: root.saved-key == "fullscreen";
                            Toggle { y: 18px; checked <=> root.hide-fullscreen; toggled => { root.changed("fullscreen"); } }
                        }
                        Row {
                            name: "Pause animations on battery saver";
                            desc: "Stops the waveform and other loops while Windows saves power.";
                            saved: root.saved-key == "saver";
                            Toggle { y: 18px; checked <=> root.saver-pause; toggled => { root.changed("saver"); } }
                        }
                    }

                    SectionTitle { text: "Reset"; }
                    Card {
                        Row {
                            first: true;
                            name: "Restore default settings";
                            desc: "Puts every setting back the way Islo shipped.";
                            Button { y: 12px; text: "Restore defaults"; clicked => { root.restore-defaults(); } }
                        }
                    }
                }

                // ======== Shortcuts ========
                if root.page == 3 : VerticalLayout {
                    spacing: 12px;
                    Card {
                        Row {
                            first: true;
                            name: "Open or close the island";
                            desc: "Works from any app.";
                            Badge { y: 18px; text: "Win + Alt + I"; }
                        }
                        Row {
                            name: "Close the island";
                            desc: "While the island is open.";
                            Badge { y: 18px; text: "Esc"; }
                        }
                        Row {
                            name: "Change volume";
                            desc: "Scroll on the island.";
                            Badge { y: 18px; text: "Scroll"; }
                        }
                        Row {
                            name: "Move the island";
                            desc: "Drag it to any edge of the screen.";
                            Badge { y: 18px; text: "Drag"; }
                        }
                    }
                }

                // ======== About ========
                if root.page == 4 : VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        padding-top: 4px;
                        padding-bottom: 8px;
                        spacing: 14px;
                        alignment: start;
                        BrandMark {
                            width: 64px;
                            height: 64px;
                            on-dark: S.dark;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "Islo"; font-size: 28px; font-weight: 600; color: S.ink; }
                            Text { text: "Version " + root.version; font-size: 12px; color: S.ink-muted; }
                        }
                    }
                    SectionTitle { text: "Updates"; }
                    Card {
                        Row {
                            first: true;
                            name: root.update-state == 2 ? "Version " + root.update-version + " is available"
                                : root.update-state == 1 ? "Checking for updates…"
                                : root.update-state == 3 ? "Installing " + root.update-version + "…"
                                : root.update-state == 4 ? "Islo is up to date"
                                : root.update-state == 5 ? "Couldn't update"
                                : "Updates";
                            desc: root.update-desc;
                            new-badge: root.update-state == 2;
                            min-h: 64px;
                            if root.update-state == 2 : Button {
                                y: 16px;
                                text: "Install and restart";
                                primary: true;
                                clicked => { root.install-update(); }
                            }
                            if root.update-state != 1 && root.update-state != 2 && root.update-state != 3 : Button {
                                y: 16px;
                                text: root.update-state == 5 ? "Try again" : "Check now";
                                clicked => { root.check-update(); }
                            }
                        }
                        Row {
                            name: "Check automatically";
                            desc: "Look for a new version when Islo starts and once a day. Nothing installs until you choose to.";
                            saved: root.saved-key == "update_check";
                            min-h: 64px;
                            Toggle { y: 22px; checked <=> root.update-check; toggled => { root.changed("update_check"); } }
                        }
                        Row {
                            name: "Release notes";
                            desc: "See what changed in each version on GitHub.";
                            Button { y: 12px; text: "Open"; clicked => { root.open-releases(); } }
                        }
                    }
                    Card {
                        Row {
                            first: true;
                            name: "What it is";
                            desc: "A Dynamic Island for Windows, written in Rust and Slint.";
                        }
                        Row {
                            name: "Memory";
                            desc: root.memory-text;
                        }
                        Row {
                            name: "Lyrics";
                            desc: "Synced lyrics come from LRCLIB (lrclib.net), a free, open lyrics database.";
                        }
                    }
                }
            }
        }

        // Save bar: always there, so it's clear when changes are waiting.
        Rectangle {
            height: 64px;
            background: root.close-warn ? (S.dark ? #2b2310 : #fff4ce) : S.surface-200;
            animate background { duration: S.quick; }
            Rectangle { y: 0; height: 1px; background: S.hairline; }
            HorizontalLayout {
                padding-left: 32px;
                padding-right: 24px;
                spacing: 8px;
                alignment: stretch;
                Rectangle {
                    width: 8px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.dirty ? S.orange : root.save-state == 2 ? #e5484d : S.positive;
                        opacity: root.dirty || root.save-state != 0 ? 1 : 0;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.save-state == 2 ? "Couldn't save"
                            : root.close-warn ? "Save your changes before closing?"
                            : root.dirty ? "You have unsaved changes"
                            : root.save-state == 1 ? "All changes saved"
                            : "No changes";
                        font-size: 14px;
                        font-weight: 600;
                        color: S.ink;
                    }
                    Text {
                        text: root.save-state == 2 ? root.save-msg
                            : root.close-warn ? "Save keeps them, Discard puts the old settings back. Either one closes the window."
                            : root.dirty ? "They take effect when you press Save."
                            : root.save-msg;
                        visible: self.text != "";
                        font-size: 12px;
                        color: root.save-state == 2 ? (S.dark ? #ff9592 : #ce2c31) : S.ink-muted;
                        overflow: elide;
                    }
                }
                Button {
                    y: 16px;
                    text: "Discard";
                    enabled: root.dirty;
                    clicked => { root.discard-changes(); }
                }
                Button {
                    y: 16px;
                    text: "Save";
                    primary: true;
                    enabled: root.dirty;
                    clicked => { root.save-changes(); }
                }
            }
        }
        }
    }
}
